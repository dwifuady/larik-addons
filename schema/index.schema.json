{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/dwifuady/larik-addons/main/schema/index.schema.json",
  "title": "Larik add-on index",
  "description": "Keep in sync with scripts/validate.ps1.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "channel", "generatedAt", "addons"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "channel": { "enum": ["official", "all"] },
    "generatedAt": { "type": "string", "format": "date-time" },
    "addons": {
      "type": "array",
      "items": { "$ref": "#/definitions/addon" }
    }
  },
  "definitions": {
    "addon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "publisher",
        "summary",
        "version",
        "contract",
        "minAppVersion",
        "platforms",
        "providerIds",
        "url",
        "sha256",
        "license",
        "homepage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 80 },
        "summary": { "type": "string", "minLength": 1, "maxLength": 200 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "contract": {
          "type": "string",
          "pattern": "^>=\\d+(\\.\\d+){0,3} <\\d+(\\.\\d+){0,3}$"
        },
        "minAppVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["win-x64", "win-arm64"] }
        },
        "providerIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" }
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "license": { "type": "string", "minLength": 1, "maxLength": 80 },
        "homepage": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "signature": {
          "type": "object",
          "additionalProperties": false,
          "required": ["keyId", "value"],
          "properties": {
            "keyId": { "type": "string", "minLength": 1 },
            "value": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
